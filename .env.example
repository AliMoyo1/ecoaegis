# EcoAegis - environment template. Copy to .env and fill in real values.
# NEVER commit .env with real keys.

# ===== App =====
SECRET_KEY=change-me-in-production
DEBUG=true
SESSION_TTL_HOURS=24

# ===== Security hardening =====
# SEC-006: IP allowlist for machine integration endpoints (ESG/asset ingest,
# channel + integration webhooks). Comma-separated IPs and/or CIDRs. EMPTY =
# no restriction (off). Set TRUST_FORWARDED_FOR=true behind a reverse proxy so
# the real client IP is read from X-Forwarded-For.
INTEGRATION_IP_ALLOWLIST=
TRUST_FORWARDED_FOR=false
# NFR-003: minimum retention period for statutory SHE records, in years.
RETENTION_YEARS=7

# ===== Database (SQLite dev default; PostgreSQL prod via DATABASE_URL) =====
# DB_PATH=ecoaegis.db
# DATABASE_URL=postgresql://user:pass@host:5432/ecoaegis

# ===== AI providers (guide 23) - pick one via AI_PROVIDER =====
AI_PROVIDER=kimi
# kimi (free while experimental via Hetzner Inference API)
KIMI_API_KEY=
KIMI_BASE_URL=https://inference.hetzner.com/api/v1
KIMI_MODEL=Kimi-K2.7-Code
# deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
# anthropic
ANTHROPIC_API_KEY=

# ===== ThemisIQ integration (Phase 3) =====
THEMIS_API_BASE=http://127.0.0.1:8080
THEMIS_API_KEY=
THEMIS_WEBHOOK_SECRET=
THEMIS_SYNC_ENABLED=false

# ===== Email =====
# EMAIL_PROVIDER=console | smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ===== Map (geospatial guide Phase 4) =====
# `leaflet` is the immediate rollback engine. Set `mapbox` only after creating
# a dedicated environment-specific PUBLIC token with minimum read scopes and
# exact HTTPS URL restrictions. Never use the Mapbox default token or a secret
# `sk.` token. The token is withheld from page HTML and released only after the
# atomic provider-account budget gate admits the page.
MAP_ENGINE=leaflet
MAP_CENTER_LAT=-19.0154
MAP_CENTER_LNG=29.1549
MAP_DEFAULT_ZOOM=6
MAP_MIN_ZOOM=5
MAP_MAX_ZOOM=18
MAP_MAX_FEATURES_PER_LAYER=2000
MAP_REQUEST_DEBOUNCE_MS=300

# Reviewed and locally vendored Mapbox GL JS release. Configuration rejects a
# different value until its assets, license, CSP behavior, and hashes are
# reviewed and updated together.
MAPBOX_GL_VERSION=3.28.1
MAPBOX_PUBLIC_TOKEN=
MAPBOX_STYLE_STANDARD=mapbox://styles/mapbox/standard
MAPBOX_STYLE_SATELLITE=mapbox://styles/mapbox/standard-satellite

# Provider-account monthly guard. At current published GL JS tiers, 180,000
# admitted initializations are approximately US$570 before tax and exchange
# effects, leaving headroom below the approved US$800 maximum. Do not raise the
# hard limit without finance approval and a pricing recheck.
MAP_PROVIDER_WARNING_LOADS=150000
MAP_PROVIDER_CRITICAL_LOADS=175000
MAP_PROVIDER_MONTHLY_LIMIT=180000
MAP_PROVIDER_NONCE_TTL_SECONDS=300

# Leaflet rollback only: full XYZ tile URL template, key included. Do NOT use
# tile.openstreetmap.org (its usage policy forbids production apps and it
# will get blocked). Pick one free-tier keyed provider:
#   MapTiler:  https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
#   Stadia:    https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY
#   Geoapify:  https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}.png?apiKey=YOUR_KEY
# Left blank, the map page shows "tile provider not configured" instead of
# a broken or policy-violating map.
MAP_TILE_URL_TEMPLATE=
MAP_TILE_ATTRIBUTION=

# No external geocoder is required. Site coordinates are entered manually,
# selected on the map, captured from an authorized device, or controlled-imported.
GEOCODER_PROVIDER=none

# ===== Messaging channels (guide A5, C2) =====
# WhatsApp Cloud API - inbound webhook verification (field reporting via chat)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Twilio - inbound SMS webhook verification (WHATSAPP_APP_SECRET/TWILIO_AUTH_TOKEN
# above) AND outbound SMS (lone-worker escalation, guide C2). Same account,
# both directions. TWILIO_FROM_NUMBER is the Twilio number outbound SMS sends
# from - without it, escalation still notifies the SHE Manager in-app, it just
# can't also text the worker's nominated contact.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_ORG_ID=1

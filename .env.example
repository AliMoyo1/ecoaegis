# EcoAegis - environment template. Copy to .env and fill in real values.
# NEVER commit .env with real keys.

# ===== App =====
SECRET_KEY=change-me-in-production
DEBUG=true
SESSION_TTL_HOURS=24

# ===== Database (SQLite dev default; PostgreSQL prod via DATABASE_URL) =====
# DB_PATH=ecoaegis.db
# DATABASE_URL=postgresql://user:pass@host:5432/ecoaegis

# ===== AI providers (guide 23) - pick one via AI_PROVIDER =====
AI_PROVIDER=kimi
# kimi (free while experimental via Hetzner Inference API)
KIMI_API_KEY=
KIMI_BASE_URL=https://inference.hetzner.com/api/v1
KIMI_MODEL=Kimi-K2.7-Code
# deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
# anthropic
ANTHROPIC_API_KEY=

# ===== ThemisIQ integration (Phase 3) =====
THEMIS_API_BASE=http://127.0.0.1:8080
THEMIS_API_KEY=
THEMIS_WEBHOOK_SECRET=
THEMIS_SYNC_ENABLED=false

# ===== Email =====
# EMAIL_PROVIDER=console | smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ===== Map (guide C1) =====
# Full Leaflet XYZ tile URL template, key included. Do NOT use
# tile.openstreetmap.org (its usage policy forbids production apps and it
# will get blocked). Pick one free-tier keyed provider:
#   MapTiler:  https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
#   Stadia:    https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY
#   Geoapify:  https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}.png?apiKey=YOUR_KEY
# Left blank, the map page shows "tile provider not configured" instead of
# a broken or policy-violating map.
MAP_TILE_URL_TEMPLATE=
MAP_TILE_ATTRIBUTION=

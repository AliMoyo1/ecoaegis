DEBUG=false
SESSION_TTL_HOURS=24
BCRYPT_ROUNDS=12
RETENTION_YEARS=7

# Uvicorn accepts proxy headers only because the app has no published host port
# and is reachable through the shared edge network. The application middleware
# can use request.client after Uvicorn has normalized the trusted proxy values.
TRUST_FORWARDED_FOR=false
INTEGRATION_IP_ALLOWLIST=

# External integrations remain disabled until their credentials and source
# restrictions are approved. The Caddy site also blocks these routes by default.
THEMIS_SYNC_ENABLED=false
EMAIL_PROVIDER=console

# The reviewed production-safe rollback engine. No unapproved tile service is used.
MAP_ENGINE=leaflet
MAP_TILE_URL_TEMPLATE=
MAP_TILE_ATTRIBUTION=
MAPBOX_PUBLIC_TOKEN=
GEOCODER_PROVIDER=none

# Optional providers remain unset. Do not place secrets in this file.
KIMI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

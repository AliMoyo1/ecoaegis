ecoaegis.alimoyo.com {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	@disabled_integrations path \
		/esg/api/ingest* \
		/assets/api/telemetry* \
		/channels/whatsapp* \
		/channels/twilio* \
		/webhooks/*
	respond @disabled_integrations 404

	request_body {
		max_size 30MB
	}

	reverse_proxy ecoaegis-app:8080 {
		header_up X-Real-IP {remote_host}

		health_uri /health
		health_interval 30s
		health_timeout 5s

		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
	}
}
